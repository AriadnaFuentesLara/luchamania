// use prisma-8
enum EstadoPago {
  @@type("pg/text@1")
  PENDIENTE = "pendiente"
  APROBADO = "aprobado"
  RECHAZADO = "rechazado"
}

enum Rol {
  @@type("pg/text@1")
  ADMINISTRADOR = "administrador"
  ASISTENTE = "asistente"
}

enum EstadoMembresia {
  @@type("pg/text@1")
  ACTIVA = "activa"
  VENCIDA = "vencida"
  SUSPENDIDA = "suspendida"
}

enum MetodoPago {
  @@type("pg/text@1")
  EFECTIVO = "efectivo"
  TILOPAY = "tilopay"
  TRANSFERENCIA = "transferencia"
  SINPE = "sinpe"
}

enum DiaSemana {
  @@type("pg/text@1")
  LUNES = "lunes"
  MARTES = "martes"
  MIERCOLES = "miercoles"
  JUEVES = "jueves"
  VIERNES = "viernes"
  SABADO = "sabado"
  DOMINGO = "domingo"
}

model Disciplina {
  id            Int                        @id @default(autoincrement())
  nombre        String                     @unique
  descripcion   String?
  activa        Boolean                    @default(true)
  creadoEn      TimestamptzString          @default(now()) @map("creado_en")
  actualizadoEn temporal.updatedAtString() @map("actualizado_en")

  @@check(expression: "char_length(trim(nombre)) BETWEEN 2 AND 80", name: "disciplina_nombre_largo")
  @@map("disciplina")
}

model Programa {
  id            Int                        @id @default(autoincrement())
  nombre        String
  disciplinaId  Int                        @map("disciplina_id")
  disciplina    Disciplina                 @relation(fields: [disciplinaId], references: [id], onDelete: Restrict)
  publicoMeta   String?                    @map("publico_meta")
  edadMinima    Int?                       @map("edad_minima")
  edadMaxima    Int?                       @map("edad_maxima")
  precioMensual Decimal                    @map("precio_mensual")
  activo        Boolean                    @default(true)
  creadoEn      TimestamptzString          @default(now()) @map("creado_en")
  actualizadoEn temporal.updatedAtString() @map("actualizado_en")

  @@unique([disciplinaId, nombre])
  @@index([disciplinaId])
  @@check(expression: "precio_mensual >= 0", name: "programa_precio_no_negativo")
  @@check(expression: "edad_minima IS NULL OR edad_minima >= 0", name: "programa_edad_minima_valida")
  @@check(expression: "edad_minima IS NULL OR edad_maxima IS NULL OR edad_minima <= edad_maxima", name: "programa_rango_edad")
  @@map("programa")
}

model Usuario {
  id               Int                        @id @default(autoincrement())
  nombre           String
  correo           String                     @unique
  contrasenaHash   String                     @map("contrasena_hash")
  rol              Rol                        @default(ASISTENTE)
  activo           Boolean                    @default(true)
  intentosFallidos Int                        @default(0) @map("intentos_fallidos")
  bloqueadoHasta   TimestamptzString?         @map("bloqueado_hasta")
  ultimoAcceso     TimestamptzString?         @map("ultimo_acceso")
  creadoEn         TimestamptzString          @default(now()) @map("creado_en")
  actualizadoEn    temporal.updatedAtString() @map("actualizado_en")

  @@check(expression: "correo = lower(correo)", name: "usuario_correo_minusculas")
  @@check(expression: "correo LIKE '%_@_%._%'", name: "usuario_correo_formato")
  @@check(expression: "intentos_fallidos >= 0", name: "usuario_intentos_no_negativos")
  @@map("usuario")
}

model Miembro {
  id                  Int                        @id @default(autoincrement())
  cedula              String                     @unique
  nombre              String
  apellidos           String
  fechaNacimiento     DateString                 @map("fecha_nacimiento")
  correo              String?
  telefono            String?
  encargadoNombre     String?                    @map("encargado_nombre")
  encargadoTelefono   String?                    @map("encargado_telefono")
  consentimientoDatos Boolean                    @default(false) @map("consentimiento_datos")
  activo              Boolean                    @default(true)
  creadoEn            TimestamptzString          @default(now()) @map("creado_en")
  actualizadoEn       temporal.updatedAtString() @map("actualizado_en")

  @@check(expression: "consentimiento_datos", name: "miembro_consentimiento_obligatorio")
  @@check(expression: "fecha_nacimiento >= DATE '1900-01-01'", name: "miembro_fecha_nacimiento_valida")
  @@map("miembro")
}

model Horario {
  id         Int        @id @default(autoincrement())
  programaId Int        @map("programa_id")
  programa   Programa   @relation(fields: [programaId], references: [id], onDelete: Cascade)
  dia        DiaSemana  @map("dia_semana")
  horaInicio TimeString @map("hora_inicio")
  horaFin    TimeString @map("hora_fin")
  lugar      String

  @@index([programaId])
  @@check(expression: "hora_inicio < hora_fin", name: "horario_horas_validas")
  @@map("horario")
}

model Inscripcion {
  id         Int               @id @default(autoincrement())
  miembroId  Int               @map("miembro_id")
  miembro    Miembro           @relation(fields: [miembroId], references: [id], onDelete: Restrict)
  programaId Int               @map("programa_id")
  programa   Programa          @relation(fields: [programaId], references: [id], onDelete: Restrict)
  fecha      DateString        @default(now()) @map("fecha_inscripcion")
  activa     Boolean           @default(true)
  creadoEn   TimestamptzString @default(now()) @map("creado_en")

  @@unique([miembroId, programaId])
  @@index([programaId])
  @@map("inscripcion")
}

model Membresia {
  id               Int             @id @default(autoincrement())
  miembroId        Int             @map("miembro_id")
  miembro          Miembro         @relation(fields: [miembroId], references: [id], onDelete: Restrict)
  estado           EstadoMembresia @default(ACTIVA)
  fechaInicio      DateString      @map("fecha_inicio")
  fechaVencimiento DateString      @map("fecha_vencimiento")

  @@index([miembroId])
  @@check(expression: "fecha_inicio <= fecha_vencimiento", name: "membresia_fechas_validas")
  @@map("membresia")
}

model Pago {
  id                Int                        @id @default(autoincrement())
  miembroId         Int                        @map("miembro_id")
  miembro           Miembro                    @relation(fields: [miembroId], references: [id], onDelete: Restrict)
  inscripcionId     Int?                       @map("inscripcion_id")
  inscripcion       Inscripcion?               @relation(fields: [inscripcionId], references: [id], onDelete: SetNull)
  metodoPago        MetodoPago                 @map("metodo_pago")
  referenciaTilopay String?                    @unique @map("referencia_tilopay")
  estado            EstadoPago                 @default(PENDIENTE)
  registradoPorId   Int?                       @map("registrado_por_id")
  registradoPor     Usuario?                   @relation(fields: [registradoPorId], references: [id], onDelete: SetNull)
  monto             Decimal
  creadoEn          TimestamptzString          @default(now()) @map("creado_en")
  actualizadoEn     temporal.updatedAtString() @map("actualizado_en")

  @@index([miembroId])
  @@check(expression: "monto > 0", name: "pago_monto_positivo")
  @@map("pago")
}

model Evento {
  id            Int                        @id @default(autoincrement())
  titulo        String
  descripcion   String?
  fecha         TimestamptzString
  lugar         String
  publicado     Boolean                    @default(false)
  creadoEn      TimestamptzString          @default(now()) @map("creado_en")
  actualizadoEn temporal.updatedAtString() @map("actualizado_en")

  @@index([publicado, fecha])
  @@map("evento")
}
