// use prisma-8

model Disciplina {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique
  descripcion String?
  activa     Boolean  @default(true)
  createdAt   TimestamptzString @default(now()) @map("created_at")
  updatedAt   temporal.updatedAtString()  @map("updated_at")
  @@map("disciplina")
}


